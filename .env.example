# ════════════════════════════════════════════════════════════════
#  Supabase — GBR Portal
#  Copy to .env and fill in values from the Supabase dashboard:
#  Project Settings → API
# ════════════════════════════════════════════════════════════════

# Project URL  (Settings → API → Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable / anon key  (safe to use in the browser)
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secret / service-role key  (NEVER expose to the browser or commit)
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWKS URL for JWT verification  (used by @supabase/server internally)
# Format: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# ── portal.html (client-side) ────────────────────────────────────────────────
# The browser portal uses SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY.
# Paste both values into the two constants at the top of portal.html.
