<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ b.name }} – {{ t.title_suffix }} in {{ b.city }}</title>
<meta name="description" content="{{ t.meta_desc | replace('{name}', b.name) | replace('{city}', b.city) }}">
{% if demo %}<meta name="robots" content="noindex, nofollow">{% endif %}
<script type="application/ld+json">{{ schema | safe }}</script>
<style>
:root{--bg:{{t.c.bg}};--surface:{{t.c.surface}};--ink:{{t.c.ink}};--muted:{{t.c.muted}};--acc:{{t.c.acc}};--acc-ink:{{t.c.acc_ink}};--line:{{t.c.line}};--r:14px}
*{box-sizing:border-box;margin:0}
body{font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--ink)}
a{color:inherit}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
.demo{background:#111;color:#fff;font-size:13px;text-align:center;padding:8px 16px}
header{position:sticky;top:0;z-index:5;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
header .wrap{display:flex;align-items:center;justify-content:space-between;height:64px;gap:16px}
.logo{font-weight:700;font-size:19px;letter-spacing:{{t.logo_ls}};text-decoration:none}
nav a{margin-left:22px;text-decoration:none;color:var(--muted);font-size:15px}
nav a:hover{color:var(--ink)}
.btn{display:inline-block;background:var(--acc);color:var(--acc-ink);padding:13px 22px;border-radius:999px;font-weight:600;text-decoration:none;border:0;cursor:pointer;font-size:16px}
.btn.ghost{background:transparent;color:var(--ink);border:1.5px solid var(--line)}
.btn:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.hero{padding:72px 0 56px}
.hero .wrap{display:grid;grid-template-columns:1.2fr .8fr;gap:48px;align-items:center}
.eyebrow{color:var(--acc);font-weight:600;font-size:14px;letter-spacing:.08em;text-transform:uppercase}
h1{font-size:clamp(34px,5vw,54px);line-height:1.08;margin:12px 0 18px;letter-spacing:-.02em}
.lead{font-size:19px;color:var(--muted);max-width:34ch}
.cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
.facts{display:flex;gap:26px;margin-top:30px;color:var(--muted);font-size:14px;flex-wrap:wrap}
.facts b{display:block;color:var(--ink);font-size:20px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:26px}
.hours li{display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px dashed var(--line);list-style:none}
.hours{padding:0}
.today{font-weight:700}
section{padding:64px 0}
h2{font-size:clamp(26px,3.4vw,36px);letter-spacing:-.01em;margin-bottom:8px}
.sub{color:var(--muted);margin-bottom:30px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px}
.svc h3{font-size:18px;margin-bottom:6px}
.svc p{color:var(--muted);font-size:15px}
.price{margin-top:12px;font-weight:700;color:var(--acc)}
.why{background:var(--surface);border-block:1px solid var(--line)}
.why .item{display:flex;gap:14px}
.ico{flex:none;width:40px;height:40px;border-radius:10px;background:var(--acc);color:var(--acc-ink);display:grid;place-items:center;font-weight:700}
.quote{font-size:17px}
.quote footer{margin-top:10px;color:var(--muted);font-size:14px}
.ph{border:1.5px dashed var(--acc);border-radius:10px;padding:10px 12px;font-size:13px;color:var(--muted);margin-top:14px}
form{display:grid;gap:12px}
label{font-size:14px;font-weight:600;display:grid;gap:6px}
input,select,textarea{width:100%;min-width:0;font:inherit;padding:12px 14px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--ink)}
input[type=checkbox]{width:auto;flex:none}
.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.small{font-size:13px;color:var(--muted)}
.map{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start}
.map>*,.two>*,.hero .wrap>*{min-width:0}
footer.site{padding:36px 0 96px;border-top:1px solid var(--line);color:var(--muted);font-size:14px}
footer.site .wrap{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
.sticky{display:none}
@media (max-width:820px){
 nav,header .btn{display:none}
 .logo{font-size:17px}
 h1{overflow-wrap:anywhere}
 .hero{padding:44px 0 36px}
 .hero .wrap,.map,.two{grid-template-columns:1fr}
 .sticky{display:flex;position:fixed;inset:auto 12px 12px 12px;z-index:9;gap:10px}
 .sticky .btn{flex:1;text-align:center;white-space:nowrap;padding:13px 12px;box-shadow:0 8px 24px rgba(0,0,0,.18)}
 main{padding-bottom:40px}
}
@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}
</style>
</head>
<body>
{% if demo %}<div class="demo" role="note">Unverbindlicher Entwurf für {{ b.name }} · nicht öffentlich gelistet · wird nach 30 Tagen gelöscht</div>{% endif %}
<header><div class="wrap">
  <a class="logo" href="#top">{{ b.name }}</a>
  <nav aria-label="Hauptnavigation"><a href="#leistungen">Leistungen</a><a href="#ueber">Über uns</a><a href="#kontakt">Anfahrt</a></nav>
  <a class="btn" href="#termin">{{ t.cta }}</a>
</div></header>

<main id="top">
<section class="hero"><div class="wrap">
  <div>
    <div class="eyebrow">{{ t.eyebrow }} · {{ b.district or b.city }}</div>
    <h1>{{ b.headline or t.headline }}</h1>
    <p class="lead">{{ b.subline or t.subline }}</p>
    <div class="cta"><a class="btn" href="#termin">{{ t.cta }}</a>{% if b.phone %}<a class="btn ghost" href="tel:{{ b.phone | replace(' ', '') }}">{{ b.phone }}</a>{% endif %}</div>
    <div class="facts">
      {% if b.rating %}<div><b>{{ b.rating }} ★</b>{{ b.reviews }} Google-Bewertungen</div>{% endif %}
      {% for f in t.facts %}<div><b>{{ f[0] }}</b>{{ f[1] }}</div>{% endfor %}
    </div>
  </div>
  <aside class="card" aria-label="Öffnungszeiten">
    <h3 style="margin-bottom:10px">Öffnungszeiten</h3>
    <ul class="hours">{% for d, h in b.hours %}<li data-day="{{ loop.index0 }}"><span>{{ d }}</span><span>{{ h }}</span></li>{% endfor %}</ul>
    <p class="small" style="margin-top:12px">{{ b.street }}, {{ b.zip }} {{ b.city }}</p>
  </aside>
</div></section>

<section id="leistungen"><div class="wrap">
  <h2>{{ t.svc_title }}</h2><p class="sub">{{ t.svc_sub }}</p>
  <div class="grid">{% for s in b.services or t.services %}
    <article class="card svc"><h3>{{ s[0] }}</h3><p>{{ s[1] }}</p>{% if s[2] %}<div class="price">{{ s[2] }}</div>{% endif %}</article>{% endfor %}
  </div>
</div></section>

<section class="why" id="ueber"><div class="wrap">
  <h2>{{ t.why_title | replace('{name}', b.name) }}</h2><p class="sub">{{ b.about or t.about }}</p>
  <div class="grid">{% for w in t.why %}
    <div class="item"><div class="ico" aria-hidden="true">{{ loop.index }}</div><div><h3 style="font-size:17px">{{ w[0] }}</h3><p class="small" style="font-size:15px">{{ w[1] }}</p></div></div>{% endfor %}
  </div>
</div></section>

<section><div class="wrap">
  <h2>Das sagen Kund:innen</h2><p class="sub">Echte Bewertungen aus dem Google-Unternehmensprofil.</p>
  <div class="grid">{% for q in b.quotes %}
    <blockquote class="card quote">„{{ q[0] }}“<footer>– {{ q[1] }}, Google</footer></blockquote>{% else %}
    <div class="card"><p class="small">Hier erscheinen 3 echte Google-Bewertungen – erst nach Freigabe durch den Betrieb.</p><div class="ph">Platzhalter · keine erfundenen Bewertungen</div></div>{% endfor %}
  </div>
</div></section>

<section id="termin" class="why"><div class="wrap map">
  <div>
    <h2>{{ t.book_title }}</h2>
    <p class="sub">{{ t.book_sub }}</p>
    {% if b.booking_url %}<a class="btn" href="{{ b.booking_url }}" rel="noopener">Freien Termin online wählen</a>
    <p class="small" style="margin-top:12px">Sie werden zum Buchungssystem des Betriebs weitergeleitet.</p>{% endif %}
    <p class="small" style="margin-top:18px">Lieber telefonisch? {% if b.phone %}<a href="tel:{{ b.phone | replace(' ', '') }}">{{ b.phone }}</a>{% endif %}</p>
  </div>
  <form class="card" action="{{ form_action }}" method="post">
    <label>Name<input name="name" autocomplete="name" required></label>
    <div class="two">
      <label>Telefon<input name="phone" type="tel" autocomplete="tel" required></label>
      <label>E-Mail<input name="email" type="email" autocomplete="email"></label>
    </div>
    <label>{{ t.form_select_label }}<select name="service">{% for s in b.services or t.services %}<option>{{ s[0] }}</option>{% endfor %}</select></label>
    {% for extra in t.form_extra %}<label>{{ extra }}<input name="extra{{ loop.index }}"></label>{% endfor %}
    <div class="two">
      <label>Wunschtag<input name="date" type="date"></label>
      <label>Uhrzeit<select name="slot"><option>vormittags</option><option>mittags</option><option>nachmittags</option></select></label>
    </div>
    <label>Nachricht (optional)<textarea name="msg" rows="3"></textarea></label>
    <label style="display:flex;gap:10px;align-items:flex-start;font-weight:400"><input type="checkbox" required style="margin-top:4px"> <span class="small">Ich bin einverstanden, dass meine Angaben zur Bearbeitung der Terminanfrage verarbeitet werden. Details in der <a href="#datenschutz">Datenschutzerklärung</a>.</span></label>
    <button class="btn" type="submit">Terminanfrage senden</button>
    <p class="small">Wir bestätigen Ihren Termin in der Regel innerhalb weniger Stunden.</p>
  </form>
</div></section>

<section id="kontakt"><div class="wrap map">
  <div><h2>Anfahrt</h2><p class="sub">{{ b.street }}, {{ b.zip }} {{ b.city }}</p>
    <p>{{ t.arrival }}</p>
    <p style="margin-top:16px"><a class="btn ghost" href="https://www.openstreetmap.org/search?query={{ (b.street ~ ' ' ~ b.zip ~ ' ' ~ b.city) | urlencode }}" rel="noopener">Route planen</a></p>
    <p class="small" style="margin-top:8px">Karte bewusst nicht eingebettet – keine Datenübertragung an Kartendienste ohne Ihren Klick.</p>
  </div>
  <div class="card"><h3>Kontakt</h3>
    {% if b.phone %}<p>Telefon: <a href="tel:{{ b.phone | replace(' ', '') }}">{{ b.phone }}</a></p>{% endif %}
    {% if b.email %}<p>E-Mail: <a href="mailto:{{ b.email }}">{{ b.email }}</a></p>{% endif %}
    {% if b.instagram %}<p>Instagram: <a href="https://instagram.com/{{ b.instagram }}" rel="noopener">@{{ b.instagram }}</a></p>{% endif %}
  </div>
</div></section>
<section id="impressum" class="small" style="padding:32px 0"><div class="wrap">
  <h3>Impressum</h3>
  {% if b.imprint %}<p>{{ b.imprint }}</p>{% else %}<div class="ph">Impressum nach § 5 DDG – wird vor Livegang mit den Pflichtangaben des Betriebs befüllt (QM-Gate 2).</div>{% endif %}
  <h3 id="datenschutz" style="margin-top:20px">Datenschutz</h3>
  <p>Diese Website setzt keine Tracking-Cookies, bindet keine externen Schriften, Karten oder Videos ein. Anfragen über das Formular werden ausschließlich zur Terminvereinbarung verwendet.</p>
  {% if not b.imprint %}<div class="ph">Vollständige Datenschutzerklärung folgt vor Livegang (Hosting, Formular-Dienst, ggf. Buchungssystem).</div>{% endif %}
</div></section>
</main>

<footer class="site"><div class="wrap">
  <span>© {{ year }} {{ b.name }}</span>
  <span><a href="#impressum">Impressum</a> · <a href="#datenschutz">Datenschutz</a></span>
</div></footer>
<div class="sticky">{% if b.phone %}<a class="btn ghost" style="background:var(--bg)" href="tel:{{ b.phone | replace(' ', '') }}">Anrufen</a>{% endif %}<a class="btn" href="#termin">{{ t.cta }}</a></div>
<script>
(function(){var d=(new Date().getDay()+6)%7;var li=document.querySelector('.hours li[data-day="'+d+'"]');if(li)li.classList.add('today');})();
</script>
</body>
</html>
